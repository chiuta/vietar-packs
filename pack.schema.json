{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "VietAR Packs: one pack manifest (data/packs/<id>.json); the built pack in data/dist/ has the same fields plus the species themselves",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "title", "region", "version", "updated", "licence", "status", "species", "count"],
  "definitions": {
    "map100": {
      "type": "object",
      "minProperties": 1,
      "maxProperties": 24,
      "propertyNames": { "pattern": "^[a-z]{2,3}$" },
      "additionalProperties": { "type": "string", "minLength": 1, "maxLength": 100 }
    },
    "map300": {
      "type": "object",
      "minProperties": 1,
      "maxProperties": 24,
      "propertyNames": { "pattern": "^[a-z]{2,3}$" },
      "additionalProperties": { "type": "string", "minLength": 1, "maxLength": 300 }
    }
  },
  "properties": {
    "id": { "type": "string", "minLength": 5, "maxLength": 40, "pattern": "^[a-z]{2}(-[a-z0-9]+)+$" },
    "title": {
      "type": "object",
      "required": ["en"],
      "minProperties": 1,
      "maxProperties": 24,
      "propertyNames": { "pattern": "^[a-z]{2,3}$" },
      "additionalProperties": { "type": "string", "minLength": 1, "maxLength": 100 }
    },
    "description": { "$ref": "#/definitions/map300" },
    "region": { "type": "string", "minLength": 2, "maxLength": 2, "pattern": "^[A-Z]{2}$" },
    "version": { "type": "string", "minLength": 5, "maxLength": 20, "pattern": "^[0-9]{1,4}[.][0-9]{1,4}[.][0-9]{1,4}$" },
    "updated": { "type": "string", "minLength": 10, "maxLength": 10, "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$" },
    "licence": { "enum": ["CC0-1.0", "CC-BY-4.0", "CC-BY-SA-4.0"] },
    "status": { "enum": ["skeleton", "draft", "reviewed"] },
    "reviewed_by": { "type": "string", "minLength": 1, "maxLength": 120 },
    "reviewed_on": { "type": "string", "minLength": 10, "maxLength": 10, "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$" },
    "authors": { "type": "array", "maxItems": 10, "items": { "type": "string", "minLength": 1, "maxLength": 80 } },
    "species": {
      "type": "array",
      "minItems": 1,
      "maxItems": 2000
    },
    "count": { "type": "integer", "minimum": 1, "maximum": 2000 }
  }
}

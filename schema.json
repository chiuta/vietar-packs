{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "VietAR Packs: one species (data/species/<id>.json)",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "latin", "kingdom", "group", "names"],
  "definitions": {
    "map80": {
      "type": "object",
      "minProperties": 1,
      "maxProperties": 24,
      "propertyNames": { "pattern": "^[a-z]{2,3}$" },
      "additionalProperties": { "type": "string", "minLength": 1, "maxLength": 80 }
    },
    "map200": {
      "type": "object",
      "minProperties": 1,
      "maxProperties": 24,
      "propertyNames": { "pattern": "^[a-z]{2,3}$" },
      "additionalProperties": { "type": "string", "minLength": 1, "maxLength": 200 }
    },
    "map300": {
      "type": "object",
      "minProperties": 1,
      "maxProperties": 24,
      "propertyNames": { "pattern": "^[a-z]{2,3}$" },
      "additionalProperties": { "type": "string", "minLength": 1, "maxLength": 300 }
    },
    "map600": {
      "type": "object",
      "minProperties": 1,
      "maxProperties": 24,
      "propertyNames": { "pattern": "^[a-z]{2,3}$" },
      "additionalProperties": { "type": "string", "minLength": 1, "maxLength": 600 }
    },
    "speciesId": { "type": "string", "minLength": 3, "maxLength": 80, "pattern": "^[a-z]+(-[a-z]+)+$" }
  },
  "properties": {
    "id": { "$ref": "#/definitions/speciesId" },
    "latin": { "type": "string", "minLength": 5, "maxLength": 80, "pattern": "^[A-Z][a-z]+( [a-z]+(-[a-z]+)?){1,2}$" },
    "kingdom": { "enum": ["animalia", "plantae", "fungi"] },
    "group": { "enum": ["mammal", "bird", "reptile", "amphibian", "fish", "invertebrate", "tree", "shrub", "herb", "fungus", "other"] },
    "names": {
      "type": "object",
      "required": ["en"],
      "minProperties": 1,
      "maxProperties": 24,
      "propertyNames": { "pattern": "^[a-z]{2,3}$" },
      "additionalProperties": { "type": "string", "minLength": 1, "maxLength": 80 }
    },
    "toxic": { "type": "boolean" },
    "toxic_note": { "$ref": "#/definitions/map300" },
    "notes": { "$ref": "#/definitions/map600" },
    "source": { "type": "string", "minLength": 1, "maxLength": 200 },
    "look_alike": {
      "type": "array",
      "maxItems": 8,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "note"],
        "properties": {
          "id": { "$ref": "#/definitions/speciesId" },
          "note": { "$ref": "#/definitions/map300" }
        }
      }
    },
    "photos": {
      "type": "array",
      "maxItems": 6,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["data", "alt", "author", "licence"],
        "properties": {
          "data": { "type": "string", "minLength": 30, "maxLength": 120000, "pattern": "^data:image/(webp|jpeg|png);base64,[A-Za-z0-9+/]+={0,2}$" },
          "alt": { "$ref": "#/definitions/map200" },
          "author": { "type": "string", "minLength": 1, "maxLength": 120 },
          "licence": { "enum": ["CC0-1.0", "CC-BY-4.0", "CC-BY-SA-4.0", "CC-BY-3.0", "CC-BY-SA-3.0", "PDM-1.0"] },
          "source_url": { "type": "string", "minLength": 9, "maxLength": 300, "pattern": "^https://[^ ]+$" },
          "commons_file": { "type": "string", "minLength": 6, "maxLength": 200, "pattern": "^File:[^/]+$" }
        }
      }
    },
    "audio": {
      "type": "array",
      "maxItems": 6,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["url", "recordist", "licence"],
        "properties": {
          "url": { "type": "string", "minLength": 24, "maxLength": 60, "pattern": "^https://(www[.])?xeno-canto[.]org/[0-9]{1,9}$" },
          "recordist": { "type": "string", "minLength": 1, "maxLength": 120 },
          "licence": { "type": "string", "minLength": 5, "maxLength": 24, "pattern": "^(CC-BY(-NC)?(-SA|-ND)?-(2[.]5|[34][.]0)|CC0-1[.]0)$" },
          "note": { "$ref": "#/definitions/map200" }
        }
      }
    }
  }
}
